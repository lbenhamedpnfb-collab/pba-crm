# ════════════════════════════════════════ PBA CRM — Variables d'environnement
# Copie ce fichier en ".env" et remplis les valeurs

# ── SÉCURITÉ ─────────────────────────────────────────────────────────────────
# Génère une clé secrète aléatoire (ex: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-moi-avec-une-cle-aleatoire-longue

# ── BASE DE DONNÉES ───────────────────────────────────────────────────────────
# En local : laisse vide (SQLite automatique)
# Sur Railway/Render : copie l'URL PostgreSQL fournie automatiquement
DATABASE_URL=

# ── EMAIL (Gmail ou autre SMTP) ───────────────────────────────────────────────
# Pour Gmail : active "Authentification à 2 facteurs" puis crée un "Mot de passe d'application"
# sur https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ton.email@gmail.com
MAIL_PASSWORD=mot-de-passe-application-gmail
MAIL_DEFAULT_SENDER=ton.email@gmail.com

# ── ENVIRONNEMENT ─────────────────────────────────────────────────────────────
# "production" en ligne, "development" en local
FLASK_ENV=development
